<Window x:Class="ComplexityResearch.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ComplexityResearch.Controls"
        xmlns:views="clr-namespace:ComplexityResearch.Views"
        Title="Оценка временной сложности алгоритмов"
        Height="960" Width="1560"
        MinHeight="720" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Window.Resources>
        <views:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== ЛЕВАЯ ПАНЕЛЬ: НАСТРОЙКИ ===================== -->
        <Border Grid.Column="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">

                    <TextBlock Text="ОЦЕНКА ВРЕМЕННОЙ СЛОЖНОСТИ АЛГОРИТМОВ"
                               FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                               Foreground="#1F3B5C" Margin="0,4,0,10"/>

                    <TextBlock Text="Алгоритм:" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Algorithms}"
                              SelectedItem="{Binding SelectedAlgorithm}"
                              DisplayMemberPath="Name"
                              Margin="0,3,0,10"/>

                    <TextBlock Text="Количество запусков (по умолчанию 5):" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding RunsText}" Margin="0,3,0,10"/>

                    <TextBlock Text="Диапазон n:" FontWeight="SemiBold"/>
                    <Grid Margin="0,3,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Start n:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding StartNText}" Margin="4,0,0,4"/>
                        <TextBlock Grid.Row="1" Text="Nmax:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NMaxText}" Margin="4,4,0,4"/>
                        <TextBlock Grid.Row="2" Text="Шаг (step):" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StepText}" Margin="4,4,0,0"/>
                    </Grid>

                    <TextBlock Text="Seed генератора данных:" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding RandomSeedText}" Margin="0,3,0,10"/>

                    <TextBlock Text="Макс. время одной точки, с (0 — без лимита):" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding MaxTimeText}" Margin="0,3,0,10"/>

                    <!-- Кэш -->
                    <TextBlock Text="База данных и кэш:" FontWeight="SemiBold"/>
                    <CheckBox Content="Use cache (брать результаты из БД)"
                              IsChecked="{Binding UseCache}" Margin="0,3,0,2"/>
                    <CheckBox Content="Force recalculation (удалить кэш ключа и пересчитать)"
                              IsChecked="{Binding ForceRecalculation}" Margin="0,2,0,6"/>
                    <TextBlock Text="{Binding DbInfoText}" FontSize="10" Foreground="#777"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Button Content="Подготовить данные" Command="{Binding PrepareDataCommand}"/>
                    <Button Content="Запустить эксперимент" Command="{Binding RunExperimentCommand}"
                            Background="#1F6FEB" Foreground="White" FontWeight="SemiBold"/>
                    <Button Content="Остановить" Command="{Binding CancelCommand}"
                            Background="#E05252" Foreground="White" FontWeight="SemiBold"/>
                    <Button Content="Возведение в степень: подсчёт операций (n = 1..1000)"
                            Command="{Binding RunPowerExperimentCommand}"
                            Background="#5B4B8A" Foreground="White" Margin="0,6,0,0"/>

                    <Separator Margin="0,10"/>

                    <!-- Двумерный эксперимент: матрицы A(n×m)·B(m×n) -->
                    <TextBlock Text="Матрицы A(n×m)·B(m×n) — тепловая карта"
                               FontWeight="Bold" Foreground="#1F3B5C" Margin="0,4,0,4"/>
                    <TextBlock Text="Диапазоны n и m (Start / Nmax / step):" FontSize="11" Foreground="#555"/>
                    <Grid Margin="0,3,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="n:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding MatrixNStartText}" Margin="4,0,3,0"/>
                        <TextBox Grid.Column="2" Text="{Binding MatrixNMaxText}" Margin="0,0,3,0"/>
                        <TextBox Grid.Column="3" Text="{Binding MatrixNStepText}"/>
                        <TextBlock Grid.Row="1" Text="m:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MatrixMStartText}" Margin="4,4,3,0"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding MatrixMMaxText}" Margin="0,4,3,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MatrixMStepText}" Margin="0,4,0,0"/>
                    </Grid>
                    <TextBlock Text="Запуски, seed и лимит ячейки берутся из общих настроек выше."
                               FontSize="10" Foreground="#888" TextWrapping="Wrap"/>
                    <Button Content="Запустить матрицы A(n×m)·B(m×n)"
                            Command="{Binding RunMatrixNMCommand}"
                            Background="#8A5B4B" Foreground="White" Margin="0,6,0,0"
                            ToolTip="Сетка n×m: для каждой пары перемножаются A(n×m)·B(m×n); результат — одна тепловая карта (X = n, Y = m, цвет = время)"/>

                    <TextBlock Text="Статус:" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <ProgressBar Height="14" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Margin="0,3,0,3"/>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock Text="{Binding CurrentDetailsText}" TextWrapping="Wrap"
                               FontSize="11" Foreground="#555" Margin="0,2,0,8"/>

                    <Separator Margin="0,8"/>

                    <Button Content="Калибровка констант" Command="{Binding CalibrateCommand}"/>
                    <TextBlock Text="{Binding CostSummary}" FontSize="11" FontFamily="Consolas"
                               TextWrapping="Wrap" Margin="0,6,0,8"/>

                    <Separator Margin="0,8"/>

                    <!-- Информация о выбранном алгоритме -->
                    <TextBlock Text="О выбранном алгоритме" FontWeight="Bold" Foreground="#1F3B5C" Margin="0,4,0,6"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,2">
                        <Run Text="Сложность: " FontWeight="SemiBold"/>
                        <Run Text="{Binding SelectedComplexity, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding SelectedDescription}" TextWrapping="Wrap" Margin="0,4,0,2"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,2">
                        <Run Text="Применение: " FontWeight="SemiBold"/>
                        <Run Text="{Binding SelectedApplication, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Формула теоретического времени:" FontWeight="SemiBold" Margin="0,6,0,2"/>
                    <TextBlock Text="{Binding SelectedFormula}" TextWrapping="Wrap"
                               FontSize="11" Foreground="#444"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== ПРАВАЯ ЧАСТЬ: ГРАФИК И ТАБЛИЦА ===================== -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Панель управления графиком: кнопки экспорта прижаты к правому краю
                 и остаются видимыми при любом размере окна, подсказка обрезается -->
            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="PNG" Command="{Binding ExportPngCommand}"
                        Margin="6,0,0,0" MinWidth="64" VerticalAlignment="Center" ToolTip="Сохранить график в PNG"/>
                <Button DockPanel.Dock="Right" Content="JSON" Command="{Binding ExportJsonCommand}"
                        Margin="6,0,0,0" MinWidth="64" VerticalAlignment="Center" ToolTip="Экспорт результатов в JSON"/>
                <Button DockPanel.Dock="Right" Content="CSV" Command="{Binding ExportCsvCommand}"
                        Margin="10,0,0,0" MinWidth="64" VerticalAlignment="Center" ToolTip="Экспорт результатов в CSV"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="Колесо — зум, перетаскивание — сдвиг, двойной щелчок — сброс"
                           FontSize="11" Foreground="#777" VerticalAlignment="Center"
                           Margin="10,0,10,0" TextTrimming="CharacterEllipsis"
                           ToolTip="Колесо — зум, перетаскивание — сдвиг, двойной щелчок — сброс"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Шкала X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <RadioButton x:Name="ScaleXLinear" Content="Обычная" IsChecked="True"
                                 GroupName="ScaleX" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Checked="Scale_CheckedChanged"/>
                    <RadioButton Content="Логарифмическая" GroupName="ScaleX"
                                 VerticalAlignment="Center" Margin="0,0,14,0"
                                 Checked="Scale_CheckedChanged"/>
                    <TextBlock Text="Шкала Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <RadioButton x:Name="ScaleYLinear" Content="Обычная" IsChecked="True"
                                 GroupName="ScaleY" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Checked="Scale_CheckedChanged"/>
                    <RadioButton Content="Логарифмическая" GroupName="ScaleY"
                                 VerticalAlignment="Center" Margin="0,0,14,0"
                                 Checked="Scale_CheckedChanged"/>
                    <CheckBox Content="Наложить предыдущий график (одни оси)"
                              IsChecked="{Binding OverlayPrevious}"
                              VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="Серии предыдущего эксперимента будут показаны на одних координатах с текущими (пунктиром, с пометкой «пред.»)"/>
                </StackPanel>
            </DockPanel>

            <!-- График (линии) и тепловая карта (A(n×m)·B(m×n)) — показывается один из них -->
            <Grid Grid.Row="1">
                <Border x:Name="ChartHost" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                    <controls:ChartControl x:Name="Chart"/>
                </Border>
                <Border x:Name="HeatmapHost" Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                        CornerRadius="4" Visibility="Collapsed">
                    <controls:HeatmapControl x:Name="Heatmap"/>
                </Border>
            </Grid>

            <!-- MSE и аппроксимация — рядом с графиком -->
            <Border Grid.Row="2" Background="#EFF5EF" BorderBrush="#CDE3CD" BorderThickness="1"
                    CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding MseText}" FontWeight="SemiBold" Foreground="#2E7D32"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ApproximationText}" FontSize="11" Foreground="#333"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="#DDDDDD"/>

            <!-- Таблица результатов -->
            <Border Grid.Row="3" Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                    CornerRadius="4" Margin="0,6,0,0">
                <DataGrid ItemsSource="{Binding Results}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          FontSize="12"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="n" Binding="{Binding LogicalN, StringFormat=N0}" MinWidth="90"/>
                        <DataGridTextColumn Header="Режим" Binding="{Binding ModeText}" MinWidth="95"/>
                        <DataGridTextColumn Header="Запусков" Binding="{Binding RunsCount}" MinWidth="70"/>
                        <DataGridTextColumn Header="Среднее, мс" Binding="{Binding AverageMs, StringFormat=F4}" MinWidth="95"/>
                        <DataGridTextColumn Header="Мин, мс" Binding="{Binding MinMs, StringFormat=F4}" MinWidth="90"/>
                        <DataGridTextColumn Header="Макс, мс" Binding="{Binding MaxMs, StringFormat=F4}" MinWidth="90"/>
                        <DataGridTextColumn Header="Ст. откл., мс" Binding="{Binding StdDevMs, StringFormat=F4}" MinWidth="95"/>
                        <DataGridTextColumn Header="Операций" Binding="{Binding OperationsTotal, StringFormat=N0}" MinWidth="110"/>
                        <DataGridTextColumn Header="Теория, мс" Binding="{Binding TheoreticalMs, StringFormat=F4}" MinWidth="95"/>
                        <DataGridTextColumn Header="Аппрокс., мс" Binding="{Binding ApproxMs, StringFormat=F4}" MinWidth="95"/>
                        <DataGridTextColumn Header="Абс. ошибка, мс" Binding="{Binding AbsDiffMs, StringFormat=F4}" MinWidth="110"/>
                        <DataGridTextColumn Header="Ошибка, %" Binding="{Binding ErrorPercent, StringFormat=F1}" MinWidth="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Вывод по результатам (формируется автоматически по данным эксперимента) -->
            <Border Grid.Row="4" Background="#FDF6E3" BorderBrush="#E8DFAF" BorderThickness="1"
                    CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                <TextBlock Text="{Binding ConclusionText}" TextWrapping="Wrap"
                           FontSize="11" Foreground="#444" MaxHeight="120"/>
            </Border>

            <!-- Результаты операционного бенчмарка возведения в степень -->
            <Border Grid.Row="5" Background="#F3EFFA" BorderBrush="#D9CFF0" BorderThickness="1"
                    CornerRadius="4" Padding="8,4" Margin="0,6,0,0"
                    Visibility="{Binding PowerResultsText, Converter={StaticResource EmptyToCollapsed}}">
                <TextBlock Text="{Binding PowerResultsText}" TextWrapping="Wrap"
                           FontSize="11" Foreground="#444" MaxHeight="120"/>
            </Border>
        </Grid>
    </Grid>
</Window>
